{
  "spec_version": "1",
  "tool": "prospeo",
  "name": "Revenue leaders at US and UK data-infrastructure software companies",
  "built_from": "The user's plain-language request in their 17 Nov 2026 chat (titles, 100-5000 staff, four industries, keywords, US 70% / UK 30%, signals A-D, exclusions a-b). Same request as apollo-spec.json, in Prospeo's own industry names and units (time in role in months: 0 to 3 months stands in for Apollo's 0 to 90 days)",
  "base": {
    "page_type": "people",
    "titles": [
      "chief revenue officer",
      "vice president of sales",
      "vice president of revenue operations",
      "head of revenue operations",
      "vice president of sales operations",
      "head of sales operations",
      "revenue operations manager",
      "vice president of customer success"
    ],
    "title_match": "contains",
    "headcount": [
      {
        "min": 100,
        "max": 5000
      }
    ],
    "industries": [
      "Software Development",
      "IT Services and IT Consulting",
      "Computer and Network Security",
      "Computer Hardware"
    ],
    "keywords": [
      "data infrastructure",
      "data platform",
      "data engineering infrastructure",
      "cloud",
      "cloud infrastructure",
      "cloud computing",
      "storage",
      "data storage",
      "storage systems",
      "cybersecurity",
      "cyber security",
      "information security",
      "AI infrastructure",
      "artificial intelligence infrastructure",
      "machine learning infrastructure",
      "developer tools",
      "developer tooling",
      "software development tools"
    ],
    "department_headcount": [
      {
        "department": "Sales",
        "min": 20
      }
    ],
    "technologies": [
      "Salesforce"
    ],
    "exclude_technologies": [
      "not using Salesforce"
    ]
  },
  "searches": [
    {
      "name": "US base (about 70% of the list)",
      "set": {
        "person_locations": [
          "United States"
        ],
        "company_locations": [
          "United States"
        ]
      }
    },
    {
      "name": "UK base (about 30% of the list)",
      "set": {
        "person_locations": [
          "United Kingdom"
        ],
        "company_locations": [
          "United Kingdom"
        ]
      }
    },
    {
      "name": "US, signal C: new in role in the last 3 months",
      "set": {
        "person_locations": [
          "United States"
        ],
        "company_locations": [
          "United States"
        ],
        "months_in_current_role": {
          "min": 0,
          "max": 3
        }
      }
    },
    {
      "name": "UK, signal C: new in role in the last 3 months",
      "set": {
        "person_locations": [
          "United Kingdom"
        ],
        "company_locations": [
          "United Kingdom"
        ],
        "months_in_current_role": {
          "min": 0,
          "max": 3
        }
      }
    },
    {
      "name": "US, signal B: hiring for RevOps or Sales Ops",
      "set": {
        "person_locations": [
          "United States"
        ],
        "company_locations": [
          "United States"
        ],
        "job_postings": [
          "revenue operations",
          "sales operations",
          "forecasting"
        ]
      }
    },
    {
      "name": "US, signal D: recent funding",
      "set": {
        "person_locations": [
          "United States"
        ],
        "company_locations": [
          "United States"
        ],
        "funding": {
          "within_days": 365
        }
      }
    }
  ]
